  },
  "claimExpectations": {
    "repository": "Sdean777/task-planner-foundation",
    "audience": "sts.amazonaws.com",
    "ref": "refs/heads/main",
    "environment": "<OPTIONAL_PROTECTED_ENVIRONMENT>",
    "workflowIdentity": "<FUTURE_WORKFLOW_IDENTITY_CONSTRAINT>"
  },
  "forbiddenTrustPatterns": [
    "Wildcard repository trust",
    "Wildcard branch trust",
    "Fork-based deployment trust",
    "Long-lived AWS keys in GitHub secrets"
  ],
  "notes": [
    "Planning artifact only.",
    "Not a live IAM trust policy.",
    "Do not store credentials or production trust JSON here."
  ]
