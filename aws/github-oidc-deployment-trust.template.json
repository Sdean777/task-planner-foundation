{
  "repositoryOwner": "Sdean777",
  "repositoryName": "task-planner-foundation",
  "audience": "sts.amazonaws.com",
  "allowedRefs": [
    "refs/heads/main"
  ],
  "allowedEnvironments": [
    "<OPTIONAL_PROTECTED_ENVIRONMENT>"
